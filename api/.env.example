DATABASE_URL=postgresql://postgres:postgres@localhost:5432/b4f_assessment
JWT_SECRET=change-me
JWT_EXPIRES_IN=8h
# mock = simulated execution (always works). judge0 = real execution through JUDGE0_URL.
EXECUTION_MODE=mock
# Example: https://ce.judge0.com  (check from Syria without a VPN first, see docs/API.md 13.3)
JUDGE0_URL=
JUDGE0_AUTH_HEADER=
JUDGE0_AUTH_TOKEN=
# Optional second header for hosted Judge0 (e.g. RapidAPI: X-RapidAPI-Host)
JUDGE0_EXTRA_HEADER=
JUDGE0_EXTRA_VALUE=
# Newest JavaScript (Node.js) id from GET <JUDGE0_URL>/languages
JUDGE0_LANGUAGE_ID=
EXECUTION_TIMEOUT_MS=10000
CLIENT_ORIGIN=http://localhost:5173
# Instructor password used by the seed. Empty = Instructor123 (local only). Always set it on a hosted server.
SEED_INSTRUCTOR_PASSWORD=
